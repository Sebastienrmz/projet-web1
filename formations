    <main>
        <section class="banniere">
            <h1 class="anim-entree">Cours &amp; <span>Formations</span></h1>
            <p class="anim-entree-2">Un programme complet pour maîtriser les fondamentaux et les technologies du numérique.</p>
        </section>

        <section class="section">
            <div class="section-titre">
                <h2>Les <span>matières principales</span></h2>
                <div class="ligne-deco"></div>
                <p>Découvrez les disciplines enseignées au département informatique.</p>
            </div>
            <div class="cartes-grid">
                <div class="carte">
                    <h3>Programmation</h3>
                    <p>Python, C, Java — apprendre à coder des algorithmes, comprendre la logique de programmation et créer des applications fonctionnelles.</p>
                </div>
                <div class="carte">
                    <h3>Développement Web</h3>
                    <p>HTML, CSS, JavaScript — concevoir des sites et applications web modernes, responsives et accessibles.</p>
                </div>
                <div class="carte">
                    <h3>Algorithmique</h3>
                    <p>Tris, arbres, graphes, complexité — apprendre à concevoir des solutions efficaces à des problèmes complexes.</p>
                </div>
                <div class="carte">
                    <h3>Bases de données</h3>
                    <p>SQL, modélisation relationnelle, requêtes complexes — stocker et manipuler des données de façon structurée et fiable.</p>
                </div>
                <div class="carte">
                    <h3>Réseaux informatiques</h3>
                    <p>Protocoles TCP/IP, routage, sécurité réseau — comprendre comment fonctionnent les communications entre machines.</p>
                </div>
                <div class="carte">
                    <h3>Cybersécurité</h3>
                    <p>Chiffrement, attaques et défenses, bonnes pratiques — protéger les systèmes et données sensibles des menaces informatiques.</p>
                </div>
                <div class="carte">
                    <h3>Intelligence Artificielle</h3>
                    <p>Machine learning, réseaux de neurones, traitement de données — introduire les bases de l'IA et ses applications concrètes.</p>
                </div>
                <div class="carte">
                    <h3>Systèmes d'exploitation</h3>
                    <p>Linux, gestion de processus, mémoire — comprendre comment un ordinateur gère ses ressources en profondeur.</p>
                </div>
            </div>
        </section>

        <section class="section" style="padding-top:0;">
            <div class="section-titre">
                <h2>Tableau <span>récapitulatif</span></h2>
                <div class="ligne-deco"></div>
            </div>
            <div class="tableau-wrapper">
                <table>
                    <caption>Programme pédagogique – Département Informatique EFREI</caption>
                    <thead>
                        <tr>
                            <th scope="col">Matière</th>
                            <th scope="col">Compétences développées</th>
                            <th scope="col">Exemple de projet</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Programmation (Python / C)</td>
                            <td>Logique algorithmique, structures de données, débogage</td>
                            <td>Mini-jeu en console, calculatrice avancée</td>
                        </tr>
                        <tr>
                            <td>Développement Web</td>
                            <td>HTML / CSS / JavaScript, responsive design, formulaires</td>
                            <td>Site vitrine, portfolio étudiant</td>
                        </tr>
                        <tr>
                            <td>Algorithmique</td>
                            <td>Complexité, tris, recherche, graphes</td>
                            <td>Visualiseur d'algorithmes de tri</td>
                        </tr>
                        <tr>
                            <td>Bases de données</td>
                            <td>Modélisation, requêtes SQL, normalisation</td>
                            <td>Système de gestion d'une bibliothèque</td>
                        </tr>
                        <tr>
                            <td>Réseaux informatiques</td>
                            <td>Modèle OSI, protocoles, configuration réseau</td>
                            <td>Simulation réseau local sous Cisco Packet Tracer</td>
                        </tr>
                        <tr>
                            <td>Cybersécurité</td>
                            <td>Cryptographie, analyse de vulnérabilités, pare-feu</td>
                            <td>CTF (Capture the Flag) interne</td>
                        </tr>
                        <tr>
                            <td>Intelligence Artificielle</td>
                            <td>Apprentissage supervisé, scikit-learn, évaluation de modèles</td>
                            <td>Classificateur d'images simple, chatbot</td>
                        </tr>
                        <tr>
                            <td>Systèmes d'exploitation</td>
                            <td>Shell Linux, scripts Bash, gestion de processus</td>
                            <td>Script d'automatisation système</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
